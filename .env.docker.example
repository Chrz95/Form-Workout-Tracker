# Copy to .env.docker and set a private random token of at least 32 characters.
# Alternatively, pnpm docker:init writes this file with a generated token.
DOCKER_API_ACCESS_TOKEN=
FORM_HTTP_PORT=8080
FORM_BIND_ADDRESS=127.0.0.1
FORM_FRONTEND_ORIGIN=http://localhost:8080
FORM_LOG_LEVEL=info
# Local proxy supplies the private token automatically. Set false for public/remote bearer-only access.
FORM_AUTO_CONNECT=true
# Optional PostgreSQL connection override; supplied only to backend/migration containers.
# FORM_DATABASE_URL=postgresql://form_local:development_only@db:5433/form
