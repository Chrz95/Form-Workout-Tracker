NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=info
API_PREFIX=/api/v1
DATABASE_URL=postgresql://form_local:development_only@localhost:5433/form
DATABASE_POOL_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_IN_MILLISECONDS=5000
# Set a private random value of at least 32 characters; the local Vite proxy supplies it privately.
API_ACCESS_TOKEN=replace_with_a_private_random_token_of_at_least_32_characters
# Optional: dedicated PostgreSQL database with a name ending in _test (never your primary database).
TEST_DATABASE_URL=postgresql://form_local:development_only@localhost:5433/form_test
# Blank, /api/v1 and legacy HTTP loopback API URLs connect automatically in local dev/built mode.
# The backend uses DATABASE_URL; the private proxy uses HOST, PORT and API_PREFIX.
# Production static previews stay disconnected; pnpm start:local enables the built local app.
# Set an HTTPS URL only for a separately hosted API requiring manual bearer token entry.
VITE_API_BASE_URL=
