NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
API_PREFIX=/api/v1
DATABASE_URL=postgresql://form_local:development_only@localhost:5433/form
DATABASE_POOL_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_IN_MILLISECONDS=5000
# Set a private random value of at least 32 characters; supply it in the app connection dialog.
API_ACCESS_TOKEN=replace_with_a_private_random_token_of_at_least_32_characters
# Optional: dedicated PostgreSQL database with a name ending in _test (never your primary database).
TEST_DATABASE_URL=postgresql://form_local:development_only@localhost:5433/form_test
# Leave blank for the private static preview; configure your HTTPS Express API for deployment.
VITE_API_BASE_URL=
