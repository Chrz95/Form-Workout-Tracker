{
  "name": "form-workout-studio",
  "private": true,
  "version": "2.10.2",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm local:init && concurrently --kill-others --names frontend,backend \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "node --watch --import tsx backend/src/server.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "docker:init": "node scripts/docker-init.mjs",
    "docker:up": "docker compose --env-file .env.docker -f compose.yaml -f compose.app.yaml up --build -d --wait --wait-timeout 180",
    "docker:down": "docker compose --env-file .env.docker -f compose.yaml -f compose.app.yaml down",
    "docker:logs": "docker compose --env-file .env.docker -f compose.yaml -f compose.app.yaml logs --tail 100 -f",
    "docker:status": "docker compose --env-file .env.docker -f compose.yaml -f compose.app.yaml ps -a",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm db:check",
    "db:test:prepare": "node --import tsx backend/src/db/prepareTestDatabase.ts",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "db:migrate": "node --import tsx backend/src/db/migrate.ts",
    "db:seed": "node --import tsx backend/src/db/seed.ts",
    "db:check": "node --import tsx backend/src/db/check.ts",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:frontend": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts && node scripts/generate-precache.mjs",
    "build:backend": "tsc -p backend/tsconfig.json",
    "preview": "vite preview --config frontend/vite.config.ts",
    "start": "node backend/dist/backend/src/server.js",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p backend/tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db": "vitest run backend/src/db/database.integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:structure": "node scripts/check-structure.mjs",
    "catalog:deduplicate": "node --import tsx scripts/consolidate-catalog.mjs",
    "db:setup:local": "pnpm local:init && pnpm db:migrate && pnpm db:seed && pnpm db:check",
    "build:local": "pnpm typecheck && vite build --config frontend/vite.config.ts --mode standalone && node scripts/generate-precache.mjs && pnpm build:backend",
    "start:local": "pnpm local:init && pnpm build:local && concurrently --kill-others --names frontend,backend \"pnpm preview\" \"pnpm start\"",
    "local:init": "node scripts/local-init.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.55.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.2",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
